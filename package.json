    "smart-meter",
    "smartmeter",
    "スマートメーター",
    "wsuha",
    "rs-wsuha",
    "bp35c0",
    "skstack"
  ],
  "license": "MIT",
  "author": "UnlitCube",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnlitCube/node-red-broute.git"
  },
  "homepage": "https://github.com/UnlitCube/node-red-broute#readme",
  "bugs": {
    "url": "https://github.com/UnlitCube/node-red-broute/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.1.0",
    "nodes": {
      "wsuha-device": "nodes/wsuha-device.js",
      "wsuha-broute": "nodes/wsuha-broute.js"
    }
  },
  "scripts": {
    "test": "node test/run-all.js"
  },
  "files": [
